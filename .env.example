APP_ENV=local
APP_NAME=neolith
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

DATABASE_URL=postgresql+psycopg://neolith:neolith_local@localhost:5432/neolith
REDIS_URL=redis://localhost:6379/0
OPA_URL=http://localhost:8181
OPA_DECISION_PATH=/v1/data/neolith/decision/result

NEOLITH_ISSUER=https://neolith.local
NEOLITH_PERMIT_TTL_SECONDS=60
NEOLITH_SIGNING_PRIVATE_KEY_PATH=.secrets/permit-ed25519-private.pem
NEOLITH_SIGNING_PUBLIC_KEY_PATH=.secrets/permit-ed25519-public.pem
NEOLITH_SIGNING_KEY_ID=local-permit-key-1

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=neolith-api

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_REASONING=
EMBEDDING_MODEL=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Multi-channel interaction adapters
# Twilio WhatsApp credentials are server-side only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_WEBHOOK_PUBLIC_URL=

# ElevenLabs Custom LLM integration. Configure this bearer value as a secret in ElevenLabs.
ELEVENLABS_CUSTOM_LLM_BEARER_TOKEN=
ELEVENLABS_CUSTOM_LLM_MODEL_ID=neolith-financial-agent

# Financial context client data mode: 'api' (default, queries live endpoints) or 'fixture' (offline deterministic dataset)
NEOLITH_FINANCIAL_DATA_MODE=api
